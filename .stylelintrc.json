{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "source",
          "custom-variant",
          "theme"
        ]
      }
    ],
    "import-notation": "string"
  }
}
