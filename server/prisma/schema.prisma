generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Último catálogo conocido sincronizado desde FUDO. Se sobrescribe (upsert
// por externalId) en cada POST /api/fudo/sync — no guarda historial.
model FudoProduct {
  id         String   @id @default(uuid())
  externalId String   @unique
  name       String
  price      Decimal  @db.Decimal(10, 2)
  category   String
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("fudo_products")
}

// Pedido de un cliente: quién lo hizo, por qué canal (type), su estado actual y el
// horario estimado que le asignó cocina. id (uuid) es el identificador real, usado para
// buscar/actualizar un pedido puntual (ver orders/service.ts#updateOrder). orderNumber es
// el correlativo visible en la UI (ej. "007") y se reinicia cada jornada comercial — ya NO es
// único en toda la base, solo dentro de una misma businessDate (ver @@unique de abajo y
// orders/businessDay.ts). Nunca usar orderNumber solo para identificar un pedido puntual:
// puede repetirse en otra jornada.
model Order {
  id            String      @id @default(uuid())
  orderNumber   Int
  // Jornada comercial a la que pertenece el pedido (ver businessDayFor() en businessDay.ts):
  // el local cierra pasada la medianoche, así que esto no es simplemente createdAt truncado
  // a medianoche calendario, sino a las 7:00, hora en que se reinicia el contador.
  businessDate  DateTime    @db.Date
  customer      String
  phone         String
  status        String
  type          String
  total         Decimal     @db.Decimal(10, 2)
  estimatedTime String?
  createdAt     DateTime    @default(now())
  // Momento en que el pedido pasó a "Entregado" (no cuándo se creó) — es lo que permite
  // distinguir "entregado hoy" de "entregado en algún momento", ver updateOrder().
  deliveredAt   DateTime?
  items         OrderItem[]

  @@unique([businessDate, orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// Contador de pedidos de una jornada comercial: una fila por jornada, incrementada de forma
// atómica (upsert con increment) en orders/service.ts#createOrder para asignar el próximo
// orderNumber sin condiciones de carrera entre pedidos creados casi al mismo tiempo.
model OrderCounter {
  businessDate DateTime @id @db.Date
  lastNumber   Int      @default(0)

  @@map("order_counters")
}

// Ítem de un pedido: producto, cantidad y precio al momento de la compra (no el
// precio actual del catálogo, para no alterar pedidos ya facturados si cambia el precio).
model OrderItem {
  id      String  @id @default(uuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  qty     Int
  price   Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

// Horario de atención del local, una fila por día de la semana (0=domingo..6=sábado,
// mismo criterio que Date#getUTCDay()). Lo edita el admin (PUT /api/business-hours) y lo
// lee el cliente (GET público) para mostrar el horario y bloquear el checkout online
// fuera de horario. `ranges` es un array JSON de `{ openTime, closeTime }` (formato "HH:mm")
// para soportar horario partido (ej. abre 11-15 y vuelve a abrir 19-23 el mismo día); si
// closeTime <= openTime dentro de una franja, esa franja cruza la medianoche (ver isOpenAt
// en businessHours/service.ts), igual que la rotisería ya opera hoy (abre hasta ~2am, ver
// orders/businessDay.ts). Un JSON por día (no una tabla hija) porque siempre se lee/escribe
// la franja completa de un día de una sola vez (PUT reemplaza la semana entera) — no hace
// falta filtrar ni ordenar franjas individuales por SQL.
model BusinessHours {
  dayOfWeek Int      @id
  isOpen    Boolean  @default(true)
  ranges    Json
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

// Ventana de retiro PROGRAMABLE de un día de la semana (0=domingo..6=sábado, mismo criterio que
// BusinessHours) — no confundir con BusinessHours, que es el horario de ATENCIÓN del local.
// Define entre qué horas la grilla de turnos (ver orders/slots.ts) ofrece horarios de retiro ese
// día puntual. `ranges` es un array JSON de `{ startTime, endTime }` (mismo formato que
// BusinessHours.ranges) para soportar franjas múltiples calcadas de un horario partido del local
// (ej. una franja de mediodía y otra de noche); a diferencia de BusinessHours, ninguna franja acá
// puede cruzar la medianoche (startTime siempre es anterior a endTime dentro del mismo día — es
// una ventana de turnos dentro de una misma jornada comercial, no un horario de apertura). Cada
// franja tiene que caer dentro de alguna franja de BusinessHours de ese mismo día — se valida en
// slotWindows/service.ts al guardar, no hay forma de guardar un horario de retiro que el local
// tenga cerrado. La gestiona cocina (PUT /api/slot-windows, solo-cocina — ni admin ni recepción,
// ver la sección de admin en AppStaff.tsx sobre por qué cada rol ve únicamente su propia
// sección), no admin. El paso entre turnos (SLOT_STEP_MINUTES) y el cupo por turno
// (SLOT_CAPACITY) siguen fijos como constantes en orders/slots.ts — no se pidió que fueran
// editables.
model SlotWindow {
  dayOfWeek Int      @id
  ranges    Json
  updatedAt DateTime @updatedAt

  @@map("slot_windows")
}

// Catálogo real del local (reemplaza el array hardcodeado que vivía en
// src/app/data/products.ts) — ver server/src/products/. id queda como Int autoincrement, no
// uuid, a propósito: el frontend ya maneja Product.id/CartItem.id como number en todo el árbol
// (carrito, pedidos manuales, etc.), así que un entero evita un cambio de tipo en cascada que
// nadie pidió. category es texto libre, misma convención que Order.status/Order.type — no hay
// una entidad Category separada porque nadie necesita gestionar categorías de forma
// independiente todavía; el admin simplemente escribe la categoría al cargar un producto. Se
// lista ordenado por id (ver listProducts en products/service.ts) para que las categorías, al
// derivarse en el frontend por orden de primera aparición, conserven el orden curado con el que
// se cargó el catálogo real la primera vez.
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Decimal  @db.Decimal(10, 2)
  description String
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  outOfStock  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images       ProductImage[]
  optionGroups ProductOptionGroup[]

  @@index([category])
  @@map("products")
}

// Grupo de opciones configurables de un producto (ej. "Sabor" en Mitad pizza, "Agregados" en
// sandwich de milanesa) — sistema genérico para no hardcodear lógica por producto puntual.
// selectionType queda como String, no enum de Prisma (misma convención que Order.status/
// Order.type): "single" (radio, uno solo), "multiple" (checkboxes, 0 o más) o "quantity"
// (reparto de unidades entre opciones, ver quantityTarget) — se tipa y valida en TS
// (products/types.ts). quantityTarget solo aplica a selectionType="quantity": es el total de
// unidades que hay que repartir entre las opciones del grupo para poder confirmar (ej. 12 para
// "Empanadas (docena)"). Se reemplaza el set completo de grupos de un producto en cada guardado
// desde el admin (ver replaceOptionGroups en products/service.ts) — no hay edición incremental,
// mismo patrón "reemplazo completo" que ya usa BusinessHours/SlotWindow con PUT.
model ProductOptionGroup {
  id             Int             @id @default(autoincrement())
  productId      Int
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  selectionType  String
  required       Boolean         @default(false)
  quantityTarget Int?
  sortOrder      Int             @default(0)
  options        ProductOption[]

  @@index([productId])
  @@map("product_option_groups")
}

// Una opción dentro de un ProductOptionGroup (ej. "Napolitana" dentro del grupo "Sabor").
// priceDelta se suma al precio base del producto cuando se elige esa opción (en grupos tipo
// "quantity", se suma multiplicado por la cantidad elegida de esa opción) — 0 si no cambia el
// precio, como en los sabores de pizza/empanada de esta primera carga.
model ProductOption {
  id         Int                @id @default(autoincrement())
  groupId    Int
  group      ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal            @default(0) @db.Decimal(10, 2)
  sortOrder  Int                @default(0)

  @@index([groupId])
  @@map("product_options")
}

// Una foto de un producto (carrusel del menú) — reemplaza la columna Product.image de un solo
// string. sortOrder define el orden de navegación del carrusel; la primera (sortOrder=0) es la
// que se usa como miniatura en tarjetas/carrito donde solo hace falta una imagen. url apunta a
// un archivo servido por el propio backend (ver express.static("/uploads") en app.ts) — las
// fotos se suben por multipart, no se pegan URLs externas (decisión de Daniel, panel admin).
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// Usuario interno (recepción, cocina, admin) con acceso a la app de staff. Alta solo por
// script de seed en este sprint (sin pantalla CRUD todavía). rol queda como String, no enum
// de Prisma, misma convención que Order.status/Order.type — los valores válidos
// ("recepcionista" | "cocina" | "admin") se tipan y validan en server/src/auth/types.ts.
model User {
  id           String   @id @default(uuid())
  nombre       String
  usuario      String   @unique
  email        String   @unique
  passwordHash String
  rol          String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@map("users")
}

// Suscripción push (Web Push API) de un dispositivo/navegador de un usuario de staff — hoy solo
// la usa cocina, para el aviso de "pedido nuevo" (ver server/src/push/service.ts#notifyKitchenNewOrder).
// endpoint es único por dispositivo/navegador: un upsert por endpoint (ver saveSubscription) evita
// duplicar la fila si el mismo dispositivo vuelve a suscribirse, y reasigna el dueño si una tablet
// compartida pasa a otro usuario logueado. onDelete: Cascade en userId porque una suscripción sin
// dueño no tiene sentido — si se borra el usuario, se borran sus suscripciones con él.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}
