generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Último catálogo conocido sincronizado desde FUDO. Se sobrescribe (upsert
// por externalId) en cada POST /api/fudo/sync — no guarda historial.
model FudoProduct {
  id         String   @id @default(uuid())
  externalId String   @unique
  name       String
  price      Decimal  @db.Decimal(10, 2)
  category   String
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("fudo_products")
}

// Eventos entrantes que el agente de WhatsApp envía a POST /api/whatsapp/webhook.
// Se guardan tal cual llegan (sin procesar todavía) para no perder pedidos
// si falla la comunicación con el agente (ver Riesgo 7 del documento de alcance).
model WhatsappInboundEvent {
  id         String   @id @default(uuid())
  type       String
  from       String
  payload    Json
  receivedAt DateTime @default(now())

  @@map("whatsapp_inbound_events")
}

// Registro de los mensajes que este sistema le pidió al agente que envíe
// (POST /api/whatsapp/notify), para poder auditar qué se le avisó a cada cliente.
model WhatsappOutboundMessage {
  id      String   @id @default(uuid())
  to      String
  message String
  success Boolean
  error   String?
  sentAt  DateTime @default(now())

  @@map("whatsapp_outbound_messages")
}

// Pedido de un cliente: quién lo hizo, por qué canal (type), su estado actual y el
// horario estimado que le asignó cocina. id (uuid) es el identificador real, usado para
// buscar/actualizar un pedido puntual (ver orders/service.ts#updateOrder). orderNumber es
// el correlativo visible en la UI (ej. "007") y se reinicia cada jornada comercial — ya NO es
// único en toda la base, solo dentro de una misma businessDate (ver @@unique de abajo y
// orders/businessDay.ts). Nunca usar orderNumber solo para identificar un pedido puntual:
// puede repetirse en otra jornada.
model Order {
  id            String      @id @default(uuid())
  orderNumber   Int
  // Jornada comercial a la que pertenece el pedido (ver businessDayFor() en businessDay.ts):
  // el local cierra pasada la medianoche, así que esto no es simplemente createdAt truncado
  // a medianoche calendario, sino a las 7:00, hora en que se reinicia el contador.
  businessDate  DateTime    @db.Date
  customer      String
  phone         String
  status        String
  type          String
  total         Decimal     @db.Decimal(10, 2)
  estimatedTime String?
  createdAt     DateTime    @default(now())
  // Momento en que el pedido pasó a "Entregado" (no cuándo se creó) — es lo que permite
  // distinguir "entregado hoy" de "entregado en algún momento", ver updateOrder().
  deliveredAt   DateTime?
  items         OrderItem[]

  @@unique([businessDate, orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// Contador de pedidos de una jornada comercial: una fila por jornada, incrementada de forma
// atómica (upsert con increment) en orders/service.ts#createOrder para asignar el próximo
// orderNumber sin condiciones de carrera entre pedidos creados casi al mismo tiempo.
model OrderCounter {
  businessDate DateTime @id @db.Date
  lastNumber   Int      @default(0)

  @@map("order_counters")
}

// Ítem de un pedido: producto, cantidad y precio al momento de la compra (no el
// precio actual del catálogo, para no alterar pedidos ya facturados si cambia el precio).
model OrderItem {
  id      String  @id @default(uuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  qty     Int
  price   Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

// Horario de atención del local, una fila por día de la semana (0=domingo..6=sábado,
// mismo criterio que Date#getUTCDay()). Lo edita el admin (PUT /api/business-hours) y lo
// lee el cliente (GET público) para mostrar el horario y bloquear el checkout online
// fuera de horario. openTime/closeTime en formato "HH:mm"; si closeTime <= openTime se
// interpreta que el cierre cruza la medianoche (ver isOpenAt en businessHours/service.ts),
// igual que la rotisería ya opera hoy (abre hasta ~2am, ver orders/businessDay.ts).
model BusinessHours {
  dayOfWeek Int      @id
  isOpen    Boolean  @default(true)
  openTime  String
  closeTime String
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

// Usuario interno (recepción, cocina, admin) con acceso a la app de staff. Alta solo por
// script de seed en este sprint (sin pantalla CRUD todavía). rol queda como String, no enum
// de Prisma, misma convención que Order.status/Order.type — los valores válidos
// ("recepcionista" | "cocina" | "admin") se tipan y validan en server/src/auth/types.ts.
model User {
  id           String   @id @default(uuid())
  nombre       String
  usuario      String   @unique
  email        String   @unique
  passwordHash String
  rol          String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("users")
}
