PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── FUDO (POS) ──────────────────────────────────────────────────────────────
# Todavía no tenemos documentación ni credenciales de la API de FUDO.
# Completar cuando estén disponibles para activar la sincronización de
# productos y precios. Ver server/src/integrations/fudo/client.ts.
FUDO_API_URL=
FUDO_API_KEY=

# ── Agente de WhatsApp (Twilio) ─────────────────────────────────────────────
# URL base de la API del agente de WhatsApp (el que ya está conectado a
# Twilio). El agente debe enviar los eventos entrantes a
# POST /api/whatsapp/webhook de este servidor.
WHATSAPP_AGENT_URL=
WHATSAPP_AGENT_API_KEY=
# Secreto opcional para validar que los webhooks entrantes vengan del agente
# (se compara contra el header "x-webhook-secret").
WHATSAPP_WEBHOOK_SECRET=
