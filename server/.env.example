PORT=4000
# Orígenes permitidos por CORS, separados por coma. En local, los dos Vite dev
# servers (cliente y staff); en producción, los dos sitios de Netlify.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Usar un rol dedicado para esta app, no el superusuario "postgres".
# Ver CLAUDE.md / README para cómo crear el rol y la base localmente.
DATABASE_URL="postgresql://los_hermanos_app:TU_PASSWORD_ACA@localhost:5432/los_hermanos"

# ── Autenticación (JWT) ──────────────────────────────────────────────────────
# Secreto simétrico (HS256) para firmar y verificar los tokens de sesión del
# staff. Obligatorio: el servidor no arranca sin esto. Generar uno random, ej.
# con `openssl rand -hex 32` — nunca reusar un valor de ejemplo en producción.
JWT_SECRET=
# Duración del token (formato de la librería "jsonwebtoken", ej. "8h", "30m").
# 8h porque cada persona de staff usa su propio dispositivo y hace un turno.
JWT_EXPIRES_IN=8h

# ── Seed del primer usuario (server/prisma/seed.ts) ─────────────────────────
# Se leen solo al correr `npm run db:seed`, nunca se guardan hardcodeadas.
# Volver a correr el script con otros valores (incluyendo SEED_ADMIN_ROL) para dar
# de alta las cuentas de recepcionista y cocina.
SEED_ADMIN_NOMBRE=
SEED_ADMIN_USUARIO=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# "recepcionista" | "cocina" | "admin" — default "admin" si se omite.
SEED_ADMIN_ROL=admin

# ── FUDO (POS) ──────────────────────────────────────────────────────────────
# Todavía no tenemos documentación ni credenciales de la API de FUDO.
# Completar cuando estén disponibles para activar la sincronización de
# productos y precios. Ver server/src/integrations/fudo/client.ts.
FUDO_API_URL=
FUDO_API_KEY=

# ── Notificaciones push (Web Push, aviso de "pedido nuevo" a cocina) ────────
# Par de claves VAPID, generadas UNA sola vez para todo el proyecto (no por entorno) con:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY además tiene que copiarse tal cual a VITE_VAPID_PUBLIC_KEY en el .env del
# frontend (ver .env.example en la raíz) — es la misma clave, no es secreta, el navegador la
# necesita para suscribirse. VAPID_PRIVATE_KEY sí es secreta: solo vive acá.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del proyecto, formato "mailto:..." — lo exige la spec de Web Push para que un
# proveedor (FCM/etc.) pueda contactar al remitente si hace falta.
VAPID_SUBJECT=mailto:ejemplo@example.com
