# URL del backend (carpeta /server). Ver server/.env.example para su configuración.
VITE_API_URL=http://localhost:4000

# Clave pública VAPID para suscribirse a notificaciones push (aviso de "pedido nuevo" a cocina).
# No es secreta — tiene que ser EXACTAMENTE la misma que VAPID_PUBLIC_KEY en server/.env.example.
VITE_VAPID_PUBLIC_KEY=
